  "stages": [
    {
      "id": "F1",
      "name": "mechanical assembly",
      "power": "none",
      "result_boundary": "fit and labeling only"
    },
    {
      "id": "F2",
      "name": "continuity",
      "power": "none",
      "result_boundary": "prove both E-stop NC channels, six bumper loops, polarity, and absence of shorts"
    },
    {
      "id": "F3",
      "name": "USB logic",
      "power": "Pico and Debug Probe USB only",
      "result_boundary": "observe UART state changes; GP11 must stay low"
    },
    {
      "id": "F4",
      "name": "12 V negative control",
      "power": "12.0 V bench supply limited to 0.20 A; USB logic already stable",
      "result_boundary": "driver may show only its small idle indicator load; relay and lamp must remain off"
    }
  ],
  "observations": [
    "The six real NC switches report their identities over UART when opened one at a time.",
    "The separate GP8, GP9, and GP10 breadboard controls exercise firmware sense/reset/charger inputs only.",
    "Power-off continuity proves each physical E-stop NC contact opens; the two channels are in series and therefore do not provide independent powered witness results on this fixture.",
    "The current target never drives GP11 high, so no coil actuation, powered E-stop de-energization, or positive witness-lamp result may be recorded.",
    "A sustained current near the 134 mA coil load or a lit lamp is a fault: remove 12 V immediately.",
    "Low-current relay contact closure on an LED witness does not qualify production contact wetting, motor current, or the motor branch."
  ]
}
