{
  "schema_version": 1,
  "fixture_id": "RB-FIXTURE-V1",
  "revision": "v1.0.0-design",
  "status": "design and hardware-free validation only; no physical result is bundled",
  "purpose": "unpowered logic fixture and current-limited negative-control witness for the deliberately fail-stopped Pico target",
  "forbidden": [
    "battery",
    "motor",
    "MDDS10",
    "production Pico",
    "powered-motion authorization"
  ],
  "printer": {
    "process": "Bambu Lab P1S, 0.4 mm nozzle, Textured PEI Plate",
    "material": "PETG",
    "bed_mm": [256, 256],
    "edge_reserve_mm": 8,
    "plate_mm": [232, 210, 4],
    "feet_below_plate_mm": 75,
    "print_orientation": "component face on the build plate; integrated hollow feet upward; flip after printing",
    "supports": false
  },
  "firmware_contract": {
    "source": "firmware/pico2-safety/src/pico_main.c",
    "pins": {
      "uart_tx": 0,
      "uart_rx": 1,
      "bumper_1": 2,
      "bumper_2": 3,
      "bumper_3": 4,
      "bumper_4": 5,
      "bumper_5": 6,
      "bumper_6": 7,
      "estop_sense": 8,
      "reset": 9,
      "charger_sense": 10,
      "relay_enable": 11
    },
    "current_target_behavior": "GP11 remains low in every state; relay coil and witness lamp must remain off",
    "reset_rule": "Remove 12 V before flashing, resetting, unplugging, or reconnecting the Pico; apply USB logic first and 12 V last only after GP11 is observed low. The driver input reset-state pull-down has not been accepted as a safety control."
  },
  "power_domains": [
    {
      "id": "USB_LOGIC",
      "nominal_v": 5,
      "source": "separate USB connections to the Pico 2 and Debug Probe",
      "limit": "USB logic only"
    },
    {
      "id": "PICO_LOGIC",
      "nominal_v": 3.3,
      "source": "Pico GPIO",
      "limit": "never connect to 12 V"
    },
    {
      "id": "BENCH_12V",
      "nominal_v": 12,
      "source": "current-limited bench supply",
      "current_limit_a": 0.2,
      "limit": "negative-control stage only; no battery"
    }
  ],
  "components": [
