  "nets": [
    {"id": "GND_COMMON", "domain": "ground", "members": ["PICO.GND", "DEBUG_PROBE.GND", "DRIVER.GND", "BENCH_12V.NEG", "BUMP_1.COM", "BUMP_2.COM", "BUMP_3.COM", "BUMP_4.COM", "BUMP_5.COM", "BUMP_6.COM", "ESTOP_SENSE_SIM.COM", "RESET_BUTTON.COM", "CHARGER_SIM.COM", "LAMP.NEG"]},
