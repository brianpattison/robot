#!/usr/bin/env bash
set -u
recorder=/usr/bin/tlog-rec-session
config=/etc/tlog/tlog-rec-session.conf
session_dir=/var/log/agent-sessions
event_file=/var/log/rover-audit/events.jsonl
logger=/usr/bin/logger
fallback_shell=/bin/bash
audit_session=
boot_id=

if [[ ${ROVER_BEAN_LOGIN_TEST:-0} == 1 ]]; then
  recorder=${ROVER_BEAN_TLOG:?test recorder required}
  config=${ROVER_BEAN_TLOG_CONFIG:?test config required}
  session_dir=${ROVER_BEAN_SESSION_DIR:?test session dir required}
  event_file=${ROVER_BEAN_EVENT_FILE:?test event file required}
  logger=${ROVER_BEAN_LOGGER:?test logger required}
  fallback_shell=${ROVER_BEAN_FALLBACK_SHELL:?test shell required}
  audit_session=${ROVER_BEAN_AUDIT_SESSION:?test audit session required}
  boot_id=${ROVER_BEAN_BOOT_ID:?test boot ID required}
elif [[ -r /proc/self/sessionid ]]; then
  audit_session=$(/usr/bin/tr -d '[:space:]' </proc/self/sessionid)
  boot_id=$(/usr/bin/tr -d '[:space:]-' </proc/sys/kernel/random/boot_id)
fi

capture_failure() {
  local status=$1
  "${logger}" -p authpriv.alert -t rover-agent-capture -- "capture_failure status=${status}; external collector must alarm"
  /usr/bin/printf '{"kind":"capture_failure","status":%d}
' "${status}" >> "${event_file}" 2>/dev/null || true
}

if [[ -x "${recorder}" && -r "${config}" && -d "${session_dir}" && -w "${session_dir}" &&
      ${audit_session} =~ ^[0-9]+$ && ${boot_id} =~ ^[0-9A-Za-z]+$ ]]; then
  session_pattern='"session"[[:space:]]*:[[:space:]]*'${audit_session}'([,}])'
  boot_pattern='"rec"[[:space:]]*:[[:space:]]*"'${boot_id}'-'
  already_recorded=0
  if [[ -f "${session_dir}/tlog.jsonl" ]] &&
      /usr/bin/grep -E "${boot_pattern}" "${session_dir}/tlog.jsonl" |
        /usr/bin/grep -Eq "${session_pattern}"; then
    already_recorded=1
  fi
  before_size=0
  if [[ -f "${session_dir}/tlog.jsonl" ]]; then
    before_size=$(/usr/bin/wc -c < "${session_dir}/tlog.jsonl")
  fi
  "${recorder}" "$@"
  recorder_status=$?
  after_size=0
  if [[ -f "${session_dir}/tlog.jsonl" ]]; then
    after_size=$(/usr/bin/wc -c < "${session_dir}/tlog.jsonl")
  fi
  if [[ ${already_recorded} -eq 1 ]]; then
    exit "${recorder_status}"
  fi
  if [[ ${after_size} -gt ${before_size} ]] &&
      /usr/bin/tail -c "+$((before_size + 1))" "${session_dir}/tlog.jsonl" |
        /usr/bin/grep -E "${boot_pattern}" |
        /usr/bin/grep -Eq "${session_pattern}"; then
    exit "${recorder_status}"
  fi
  capture_failure "${recorder_status}"
else
  capture_failure 127
fi

if [[ ${1:-} == -c ]]; then
  # The recorder may already have executed a non-idempotent remote command.
  # Raise the gap alarm and preserve its status; never replay the command.
  exit "${recorder_status:-125}"
fi
exec "${fallback_shell}" "$@"
